{
  "expo": {
    "name": "Hifz Cards",
    "slug": "hifz-cards",
    "scheme": "hifzcards",
    "version": "1.0.0",
    "orientation": "portrait",
    "jsEngine": "hermes",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f6f2ea",
    "icon": "./assets/app-icon/icon-ios.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yacoobali.hifz",
      "icon": "./assets/app-icon/icon-ios.png"
    },
    "android": {
      "package": "com.yacoobali.hifz",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.yacoobali.hifz",
      "icon": "./assets/app-icon/icon-android.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/icon-android.png",
        "backgroundColor": "#0f3b30"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0f3b30",
          "defaultChannel": "hifz-cards"
        }
      ],
      "expo-audio",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9dcd48ff-06d6-487c-a3d4-9fb5aa0d5759"
      }
    }
  }
}
